{
  "profiles": {
    "release": {
      "build": {
        "command": "pnpm",
        "args": [
          "tauri",
          "build",
          "--no-bundle"
        ]
      },
      "stageDir": "dist-app/v5-windows",
      "files": [
        {
          "from": "src-tauri/target/release/ai-draw-app.exe",
          "to": "ai-draw-app.exe"
        },
        {
          "from": "src-tauri/target/release/ai-draw-backend.exe",
          "to": "ai-draw-backend.exe"
        },
        {
          "from": "src-tauri/target/resources/assets",
          "to": "assets"
        }
      ]
    },
    "dev": {
      "build": {
        "command": "pnpm",
        "args": [
          "build:exe:dev"
        ]
      },
      "stageDir": "dist-app/v5-windows-dev",
      "files": [
        {
          "from": "src-tauri/target/debug/ai-draw-app.exe",
          "to": "ai-draw-app.exe"
        },
        {
          "from": "src-tauri/target/debug/ai-draw-backend.exe",
          "to": "ai-draw-backend.exe"
        },
        {
          "from": "src-tauri/target/resources/assets",
          "to": "assets"
        }
      ]
    }
  }
}
