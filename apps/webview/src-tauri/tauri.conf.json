{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webview",
  "version": "0.1.15",
  "identifier": "com.fastwindow.webview",
  "build": {
    "beforeDevCommand": "pnpm build:backend && pnpm build:resources && pnpm dev",
    "devUrl": "http://127.0.0.1:1440",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "webview",
        "width": 920,
        "height": 620,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/webview-backend"
    ],
    "resources": {
      "../assets/": "assets"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
