{
  "name": "@fast-window/app-eucli-studio",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "build:backend": "node scripts/build-backend.mjs",
    "build:resources": "node scripts/build-resources.mjs",
    "build:exe": "pnpm build:ui && pnpm tauri build",
    "build:exe:dev": "pnpm tauri build --debug --no-bundle --config src-tauri/tauri.conf.dev.json",
    "build:ui": "pnpm build:backend && vite build && pnpm build:resources",
    "build:app": "node scripts/stage-app.mjs",
    "build:app:dev": "node scripts/stage-app.mjs --profile dev",
    "build:app:exe": "node scripts/sync-app-exe.mjs",
    "build:app:exe:dev": "node scripts/sync-app-exe.mjs --profile dev",
    "build:app:package": "node scripts/package-app.mjs",
    "apps:version:check": "node scripts/bump-app-version.mjs --check",
    "apps:bump:dry": "node scripts/bump-app-version.mjs --dry-run",
    "apps:bump": "node scripts/bump-app-version.mjs",
    "dev": "vite --host 127.0.0.1 --port 1431",
    "dev:app": "pnpm build:backend && pnpm build:resources && pnpm tauri dev",
    "tauri": "tauri",
    "test": "pnpm test:build && pnpm test:unit",
    "test:build": "node --test \"scripts/tests/**/*.test.mjs\"",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tauri-apps/api": "^2.11.0",
    "dompurify": "^3.0.11",
    "katex": "^0.16.11",
    "marked": "^12.0.2",
    "mermaid": "^10.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
