# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-ssr/
apps/*/dist-app/
*.local

# Local temp / artifacts
.tmp/
plugin-store/

# Runtime app data
data/
plugins/**/backup/
plugins/**/*.map

# Tauri / Rust
src-tauri/target/
apps/*/src-tauri/target/
apps/*/src-tauri/binaries/
apps/*/backend-go/*.exe

# 语言学习应用：参考词库（外部研究数据，不入库）
apps/language-learning/reference-wordlists/

# Legacy generated dirs (已废弃的随包插件种子机制遗留；保持忽略，避免误提交)
src-tauri/plugin-seeds/
src-tauri/plugins/
src-tauri/runtimes/

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Environment
.env
.env.*
!.env.example

# TypeScript cache
*.tsbuildinfo

.dev-management/
dev-docs/

# 外来独立仓库（apps/ 下的嵌套 git 仓库）不使用本文件登记：走本地排除清单
# .git/info/exclude（不进版本库、不上传云端）。新增外来仓库时请在那边追加，不要写到这里。
